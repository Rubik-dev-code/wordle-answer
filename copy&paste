(async () => {
    const sleep = ms => new Promise(res => setTimeout(res, ms));

    const typeWord = async (word) => {
        for (let letter of word.toUpperCase()) {
            const targetKey = Array.from(document.querySelectorAll('button, [data-key]'))
                                   .find(el => el.textContent.trim().toUpperCase() === letter || el.getAttribute('data-key') === letter.toLowerCase());
            if (targetKey) {
                targetKey.click();
                await sleep(150);
            }
        }
        
        const enterKey = Array.from(document.querySelectorAll('button, [data-key]'))
                              .find(el => el.textContent.trim().toUpperCase() === 'ENTER' || el.getAttribute('data-key') === '↵');
        if (enterKey) {
            enterKey.click();
            await sleep(1800); 
        }
    };

    // 1. Enter the distraction entries
    const standardGuesses = ["TRUCK", "LIGHT"];
    console.log("🤖 Typing distraction entries...");
    for (let word of standardGuesses) {
        await typeWord(word);
    }

    // 2. Mock Calculating Delay
    alert("🤖 AI Solver: Syncing Johnston/Grimes timezone matrices... please wait.");
    await sleep(1000);

    // 3. Force the date calculation to use Central Standard Time (CST)
    let solution = "";
    try {
        const formatter = new Intl.DateTimeFormat('en-US', {
            timeZone: 'America/Chicago', // Explicitly locks the region to your local Central Time
            year: 'numeric',
            month: '2-digit',
            day: '2-digit'
        });
        
        const [{ value: month },,{ value: day },,{ value: year }] = formatter.formatToParts(new Date());
        const localDateString = `${year}-${month}-${day}`;
        
        console.log(`📡 Fetching live puzzle data for local date: ${localDateString}`);

        // Pull the live answer text file from the public dictionary
        const response = await fetch(`https://www.nytimes.com/svc/wordle/v2/${localDateString}.json`);
        const data = await response.json();
        
        if (data && data.solution) {
            solution = data.solution.toUpperCase();
            console.log("🎯 Solution extracted successfully:", solution);
        }
    } catch (e) {
        console.error("❌ Clock alignment failed:", e);
    }

    // 4. Submit the verified winning word
    if (solution && solution.length === 5) {
        await typeWord(solution);
        console.log("🎉 Run complete!");
    } else {
        console.error("⚠️ Failed to capture the active solution word.");
    }
})();
